# Optional overrides. Defaults work for local development.
# Set NEXT_PUBLIC_API_URL in apps/web/.env.local when the API is remote.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
# Set WEB_ORIGIN, HOST and PORT in the API process when deploying separately.
WEB_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=4000
