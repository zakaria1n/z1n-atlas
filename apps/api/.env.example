# Z1N Atlas backend environment. Copy this file to apps/api/.env and fill in
# your own values. apps/api/.env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Developer-owned LLM credentials (backend only; the frontend never sees them)
# ---------------------------------------------------------------------------
# At least one key enables live provider tests and, when the flag below is
# set, server-managed AI on your local development server.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Alternative spelling for Gemini; GEMINI_API_KEY wins when both are set.
# GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Default AI configuration
# ---------------------------------------------------------------------------
# One of: openai, google, anthropic
AI_DEFAULT_PROVIDER=
# Fallback model for every provider that has no specific default below.
AI_DEFAULT_MODEL=
# Provider-specific defaults win over AI_DEFAULT_MODEL.
OPENAI_DEFAULT_MODEL=
GEMINI_DEFAULT_MODEL=
# GOOGLE_DEFAULT_MODEL=
ANTHROPIC_DEFAULT_MODEL=

# ---------------------------------------------------------------------------
# Real integration tests — opt-in
# ---------------------------------------------------------------------------
# When true, `pnpm test:llm:live` makes real, billable provider requests.
# The normal test suite never runs live requests regardless of this value.
RUN_LIVE_LLM_TESTS=false

# ---------------------------------------------------------------------------
# Development-only backend-key access
# ---------------------------------------------------------------------------
# When true and the server is NOT in production, /api/ai/status reports the
# configured provider and AI features can run with the backend key instead of
# a personal key. Production servers ignore this flag entirely.
ENABLE_DEV_LLM_KEYS=false

# ---------------------------------------------------------------------------
# Server binding (existing variables, unchanged)
# ---------------------------------------------------------------------------
# PORT=4000
# HOST=127.0.0.1
# WEB_ORIGIN=http://localhost:3000
